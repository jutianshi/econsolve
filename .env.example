# ================================
# EconSolve 环境变量配置模板
# 复制此文件为 .env 并填写实际值
# ================================

# ---- 应用端口 ----
PORT=3001

# ---- Node 环境 ----
NODE_ENV=production

# ---- LLM API 密钥（至少配置一个即可启用真实解析）----
# OpenAI (GPT-4o, o3-mini 等)
OPENAI_API_KEY=

# Anthropic (Claude 3.7 Sonnet 等)
ANTHROPIC_API_KEY=

# DeepSeek (R1, V4-Pro 等)
DEEPSEEK_API_KEY=

# ---- 自定义 API 地址（可选，用于代理）----
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com
